# Git ignore for repos root

# Ignore all projects - they have their own repos
projects/

# Ignore Python virtual environments
venv/
env/
ENV/
.venv

# Ignore Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Ignore macOS
.DS_Store

# Ignore IDE
.vscode/
.idea/
*.swp
*.swo

# Ignore temporary files
*.tmp
*.log
*.bak

# Ignore sensitive data
.env
*.key
*.pem
secrets/

# projects/ har egne git repos - ignoreres her
